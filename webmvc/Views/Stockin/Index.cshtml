@model IEnumerable<webmvc.Models.Buoi12.Stockin>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.StockinId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderTime)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.StockinId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderTime)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.StockinId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.StockinId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.StockinId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
