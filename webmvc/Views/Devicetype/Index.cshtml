@model IEnumerable<webmvc.Models.Buoi12.Devicetype>

@{
    ViewData["Title"] = "Index";
}

<h1>Danh sách các loại thiết bị</h1>

<p>
    <a asp-action="Create">Thêm mới</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DevicetypeId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DevicetypeName)
            </th>

      
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.DevicetypeId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DevicetypeName)
                </td>

         
                <td>
                    <a asp-action="Edit" asp-route-id="@item.DevicetypeId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.DevicetypeId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.DevicetypeId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
