@using webmvc.Models.Entities
@model webmvc.Models.ViewModels.PagedResult<Student>
 


<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        Show
        <select id="pageSizeSelect" class="form-select d-inline-block w-auto">
            <option value="10" selected="@(Model.PageSize == 10)">
                10
            </option>
            <option value="20" selected="@(Model.PageSize == 20)">
                20
            </option>
            <option value="50" selected="@(Model.PageSize == 50)">
                50
            </option>
            <option value="100" selected="@(Model.PageSize == 100)">
                100
            </option>
        </select>
        entries
    </div>
    
</div>
<table class="table table-bordered table-striped">

    <thead class="table-dark">
        <tr>
            <th>Mã SV</th>
            <th>Họ và Tên</th>
            <th>Khoa</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Any())

        {
            foreach (var student in Model.Items)
            {
                <tr>
                    <td>@student.StudentCode</td>
                    <td>@student.FullName</td>
                    <td>@(student.Faculty != null ? student.Faculty.FacultyName : "Chưa xếp khoa")</td>
                    <td>
                        <button class="btn btn-warning btn-sm btn-edit" data-code="@student.StudentCode">Sửa</button>
                        <button class="btn btn-danger btn-sm btn-delete" data-code="@student.StudentCode">Xóa</button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">Không có sinh viên nào trong danh sách</td>
            </tr>
        }
    </tbody>
</table>

<!-- Thanh Phân Trang (Giữ nguyên logic của bạn, dọn bớt thẻ đóng dư) -->
<div class="d-flex justify-content-between align-items-center mt-3">
    <div>
        Showing
        <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong>
        to
        <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems))</strong>
        of
        <strong>@Model.TotalItems</strong>
        entries
    </div>
    <nav>
        <ul class="pagination mb-0">
            @{
                int startPage = Math.Max(1, Model.CurrentPage - 2);
                int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
            }
            
            <!-- Previous -->
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a href="#" class="page-link pagination-link" data-page="@(Model.CurrentPage - 1)">Previous</a>
            </li>

            <!-- First Page -->
            @if (startPage > 1)
            {
                <li class="page-item">
                    <a href="#" class="page-link pagination-link" data-page="1">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            <!-- Middle Pages -->
            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a href="#" class="page-link pagination-link" data-page="@i">@i</a>
                </li>
            }

            <!-- Last Page -->
            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a href="#" class="page-link pagination-link" data-page="@Model.TotalPages">@Model.TotalPages</a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a href="#" class="page-link pagination-link" data-page="@(Model.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
</div>