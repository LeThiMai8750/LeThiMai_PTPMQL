@model IEnumerable<webmvc.Models.Buoi12.Suplier>

@{
    ViewData["Title"] = "Index";
}

<h1>Danh sách Nhà cung cấp </h1>

<p>
    <a asp-action="Create">Thêm mới NCC</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SuplierName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SuplierName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SuplierId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.SuplierId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.SuplierId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
