@model webmvc.Models.Buoi12.Suplier

@{
    ViewData["Title"] = "Create";
}

<h1>Thêm mới NCC</h1>

<h4>Suplier</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="SuplierName" class="control-label">Tên nhà cung cấp</label>
                <input asp-for="SuplierName" class="form-control" />
                <span asp-validation-for="SuplierName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
